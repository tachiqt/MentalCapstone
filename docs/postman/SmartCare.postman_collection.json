{
  "info": {
    "_postman_id": "smartcare-api-v1",
    "name": "SmartCare API",
    "description": "SmartCare therapy center API (Laravel Sanctum). Set {{baseUrl}} and run Login to populate {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "childId",
      "value": "1"
    },
    {
      "key": "assessmentId",
      "value": "1"
    },
    {
      "key": "recommendationId",
      "value": "1"
    },
    {
      "key": "medicationScheduleId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"head_doctor\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/logout"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Teacher\",\n  \"username\": \"teacher_new\",\n  \"email\": \"teacher_new@example.com\",\n  \"password\": \"password\",\n  \"role\": \"teacher\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    },
    {
      "name": "Children",
      "item": [
        {
          "name": "List Children",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/children"
          }
        },
        {
          "name": "Show Child",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/children/{{childId}}"
          }
        },
        {
          "name": "Create Child",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alex\",\n  \"last_name\": \"Rivera\",\n  \"age_band\": 6,\n  \"diagnosis\": \"ASD\",\n  \"is_active\": true\n}"
            },
            "url": "{{baseUrl}}/children"
          }
        },
        {
          "name": "Assign User to Child",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"relation\": \"teacher\"\n}"
            },
            "url": "{{baseUrl}}/children/{{childId}}/assign"
          }
        }
      ]
    },
    {
      "name": "Assessments",
      "item": [
        {
          "name": "List Assessments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/children/{{childId}}/assessments"
          }
        },
        {
          "name": "Create Assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checklist_id\": 1,\n  \"severity_level\": \"moderate\",\n  \"conditions_json\": [\"autism_spectrum\"],\n  \"notes\": \"Initial screening\",\n  \"responses\": [\n    {\n      \"checklist_item_id\": 1,\n      \"score\": \"2\",\n      \"comment\": \"Needs prompting\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/children/{{childId}}/assessments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('assessmentId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Assessment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assessments/{{assessmentId}}"
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Generate Recommendation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assessment_id\": {{assessmentId}}\n}"
            },
            "url": "{{baseUrl}}/children/{{childId}}/recommendations/generate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('recommendationId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Recommendations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/children/{{childId}}/recommendations"
          }
        },
        {
          "name": "Review Recommendation (Approve)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"teacher_notes\": \"Approved for classroom implementation.\"\n}"
            },
            "url": "{{baseUrl}}/recommendations/{{recommendationId}}/review"
          }
        }
      ]
    },
    {
      "name": "Therapy",
      "item": [
        {
          "name": "List Therapy Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/therapy-sessions?child_id={{childId}}",
              "host": ["{{baseUrl}}"],
              "path": ["therapy-sessions"],
              "query": [
                {
                  "key": "child_id",
                  "value": "{{childId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Suggest Therapy Schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child_id\": {{childId}},\n  \"sessions_per_week\": 2\n}"
            },
            "url": "{{baseUrl}}/therapy-sessions/suggest"
          }
        },
        {
          "name": "Create Therapy Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child_id\": {{childId}},\n  \"teacher_id\": 2,\n  \"scheduled_at\": \"2026-08-15 10:00:00\",\n  \"duration_minutes\": 60,\n  \"status\": \"scheduled\"\n}"
            },
            "url": "{{baseUrl}}/therapy-sessions"
          }
        }
      ]
    },
    {
      "name": "Medications",
      "item": [
        {
          "name": "List Medication Schedules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medication-schedules?child_id={{childId}}",
              "host": ["{{baseUrl}}"],
              "path": ["medication-schedules"],
              "query": [
                {
                  "key": "child_id",
                  "value": "{{childId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Create Medication Schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child_id\": {{childId}},\n  \"medicine_name\": \"Melatonin\",\n  \"dosage\": \"3mg\",\n  \"instructions\": \"Give at bedtime\",\n  \"time_of_day\": \"20:00\",\n  \"days_of_week\": [0, 1, 2, 3, 4, 5, 6]\n}"
            },
            "url": "{{baseUrl}}/medication-schedules"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('medicationScheduleId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Medication Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/children/{{childId}}/medication-logs"
          }
        },
        {
          "name": "Log Medication Dose",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medication_schedule_id\": {{medicationScheduleId}},\n  \"child_id\": {{childId}},\n  \"status\": \"given\",\n  \"administered_at\": \"2026-08-08T20:00:00+08:00\",\n  \"notes\": \"Taken with water\"\n}"
            },
            "url": "{{baseUrl}}/medication-logs"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Facility Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reports/facility"
          }
        },
        {
          "name": "Child Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reports/children/{{childId}}"
          }
        }
      ]
    }
  ]
}
